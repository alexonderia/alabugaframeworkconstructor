# Copy to .env for Docker. Never commit local .env files.
AF_WEB_PORT=4176
# Independent Framework reference site, compiled into the web image.
VITE_FRAMEWORK_DOCS_URL=http://127.0.0.1:4391/
AF_WEB_IMAGE=alabuga-web:local
AF_API_IMAGE=alabuga-api:local
AF_AI_CONTEXT=4096
# Default internal Ollama service; native alternative must be reachable from Docker.
AF_OLLAMA_URL=http://ollama:11434
AF_ALLOWED_ORIGINS=http://127.0.0.1:4176,http://localhost:4176

ALABUGA_NPM_REGISTRY=https://npm.example.org/
ALABUGA_NPMRC_FILE=/absolute/path/to/registry-read.npmrc
