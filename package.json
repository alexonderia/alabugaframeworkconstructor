{
  "name": "@alabuga/constructor",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "ai:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ai.ps1",
    "ai": "npm run build && tsx scripts/start-ai.ts",
    "demo": "npm run build && tsx scripts/start-ai.ts --demo",
    "demo:rehearse": "tsx scripts/demo-rehearsal.ts",
    "ai:server": "tsx apps/ai-server/src/ai-server.ts",
    "test:ai": "tsx --test tests/ai.test.ts tests/ai-server.test.ts tests/ai-content.test.ts tests/ai-reliability.test.ts",
    "ai:acceptance": "node scripts/ai-live.mjs",
    "ai:examples": "node scripts/ai-live.mjs --examples",
    "ai:report": "python scripts/ai-report.py",
    "test:ai-report": "python -m unittest discover -s tests -p ai_report_test.py",
    "predev": "tsx scripts/build-docs.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run check:boundaries && npm run check:ui && tsx scripts/build.ts",
    "test": "tsx --test tests/editor.test.ts tests/editor-save.test.ts tests/project-import.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --outDir dist/site --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:ui": "node scripts/check-ui-styles.mjs",
    "build:editor": "npm run build -w @alabuga/editor",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:ai": "npm run build -w @alabuga/ai",
    "build:server": "npm run build -w @alabuga/ai-server",
    "test:bootstrap": "tsx --test tests/bootstrap.test.ts tests/pinned-model.test.ts",
    "test:model": "tsx scripts/run-model-check.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "test:release": "node scripts/release-smoke.mjs",
    "registry:configure": "node scripts/configure-registry.mjs",
    "test:compatibility": "node scripts/check-framework-version.mjs",
    "test:docker": "playwright test --config=playwright.docker.config.ts"
  },
  "dependencies": {
    "zod": "^4.5.4",
    "@alabuga/framework": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "marked": "17.0.5",
    "postcss": "8.5.28",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.17.0",
  "license": "UNLICENSED",
  "alabugaFramework": {
    "minimum": "1.2.0",
    "major": 1
  }
}
