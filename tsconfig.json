{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "packages",
    "apps",
    "demos",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts"
  ]
}
